# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRO_PRICE_ID=

# App
# NEXT_PUBLIC_SITE_URL is the canonical deployment URL (no trailing slash).
# Used for metadata, sitemaps and OAuth fallbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL is the legacy name; still supported as a fallback.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google AdSense (optional — ads render only when set)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
